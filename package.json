{
  "name": "work-dashboard",
  "version": "3.6.5",
  "description": "업무데스크 오르빗 — 선생님의 하루가 도는 곳 (HSOrbit)",
  "main": "./out/main/index.js",
  "author": "정현서",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "node scripts/make-icon.mjs",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^4.10.38",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@fontsource/nunito": "5.3.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "kordoc": "4.15.7",
    "pptxgenjs": "4.0.1",
    "pretendard": "1.3.9",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
